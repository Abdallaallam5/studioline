# ─── App ────────────────────────────────────────────────────────────────
# Public base URL, used to build links (setup, invitation, reset). No trailing slash.
# On Vercel you can leave it unset: the project's production domain is used.
APP_URL=http://localhost:3000

# ─── Database (MongoDB Atlas) ───────────────────────────────────────────
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studioline
# Local dev without Atlas: run `npm run db:dev` and use the URI below.
MONGODB_URI=mongodb://127.0.0.1:27017/studioline

# ─── Platform owner (used once by `npm run seed:owner`) ─────────────────
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# ─── Email ──────────────────────────────────────────────────────────────
# console = print emails to the server log (development only)
# smtp    = any SMTP server
# resend  = Resend HTTP API
EMAIL_PROVIDER=console
EMAIL_FROM="Studioline <no-reply@example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

RESEND_API_KEY=

# ─── File storage ───────────────────────────────────────────────────────
# mongodb    = store files in the MongoDB database itself (default; no extra service,
#              works on free serverless hosting; best for small files)
# cloudinary = Cloudinary (larger files / heavier use)
# local      = write to ./.uploads (development only, not for serverless)
STORAGE_PROVIDER=mongodb
# Vercel rejects request bodies over 4.5 MB, so keep this at 4 there.
MAX_UPLOAD_MB=4

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=studioline

# ─── Scheduled jobs ─────────────────────────────────────────────────────
# Shared secret for /api/cron/* endpoints (Vercel Cron sends it as a Bearer token).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
